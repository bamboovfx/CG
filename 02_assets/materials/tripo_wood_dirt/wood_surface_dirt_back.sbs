      <identifier v="wood_surface_dirt_back" />
      <uid v="1001" />
      <graphtype v="material" />
      <attributes>
        <label v="Surface dirt / back" />
        <description v="Independent surface residue, tiny clustered dark specks and faint wipe smudges. Direct 4096 placement; CC0 scan colour and roughness supply broken contours/content. White mask deposits dirt. Height 0–25 micrometres, metallic 0. Existing process and ageing remain external unchanged." />
      </attributes>
