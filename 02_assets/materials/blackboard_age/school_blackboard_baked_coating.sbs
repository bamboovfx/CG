  <content>
    <graph>
      <identifier v="school_blackboard_baked_coating" />
      <uid v="1001" />
      <graphtype v="material" />
      <attributes>
        <label v="School blackboard | baked coating and use history" />
        <description v="Original spatial masks plus CC0 eraser-detail photograph, high-pass filtered as a chalk placement mask. Baked green coating, polished upper use zone, embedded chalk, felt sweeps, subtle window-side fading; lower quarter less used. Colour/roughness are authored independently, not scanned PBR. Surface 4.1438 x 1.49 m. Fine coating tooth is added at render time. Exposure mask is an artistic assumption, not a measured UV dose." />
      </attributes>
