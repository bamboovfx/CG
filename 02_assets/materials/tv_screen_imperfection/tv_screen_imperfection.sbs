      <graphtype v="material" />
      <attributes>
        <label v="CRT glass / layered imperfections" />
        <description v="Original native graph. Separate oil, dry deposits, curved wiping, fine scratches, crossed long scratches and clustered abrasion. One tile represents 0.8 m. No reference bitmap input or baked lighting." />
      </attributes>
